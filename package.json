{
  "name": "zenith-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive satellite mission planner and orbital mechanics educational tool",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "wasm:build": "cd wasm && bash build.sh"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.7.0",
    "katex": "^0.18.9",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.170.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/katex": "^0.16.8",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.0.0",
    "jsdom": "^30.1.0",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-top-level-await": "^1.0.0",
    "vite-plugin-wasm": "^3.0.0",
    "vitest": "^5.0.1"
  }
}
